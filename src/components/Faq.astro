---
interface FaqItem {
  q: string;
  a: string;
}

interface FaqGroup {
  title: string;
  items: FaqItem[];
}

interface Props {
  groups: FaqGroup[];
}

const { groups } = Astro.props;
---
<div class="faq">
  {groups.map((group) => (
    <section class="faq__group">
      <h2>{group.title}</h2>
      <div class="faq">
        {group.items.map((item) => (
          <details class="faq__item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </section>
  ))}
</div>
