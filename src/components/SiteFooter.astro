---
import { navLinks, licensee, company, contact } from '../data/site';
const year = new Date().getFullYear();

interface Props {
  base?: string;
}

const { base = '' } = Astro.props;
---
<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__grid">
      <div>
        <p class="site-footer__brand">
          <img src={`${base}assets/igreen-logomarca-neon.svg`} alt="" aria-hidden="true" />
          <span>Energia limpa. Bolso cheio.</span>
        </p>
        <p class="site-footer__licensee">
          {licensee.role}
          <span>·</span>
          {licensee.name}
          <span>· ID</span>
          <span class="is-placeholder">{licensee.id}</span>
        </p>
        <a class="btn btn--whatsapp site-footer__whatsapp" href={contact.whatsapp} target="_blank" rel="noopener" aria-label="Falar com o licenciado pelo WhatsApp">
          <svg viewBox="0 0 24 24" width="19" height="19" fill="currentColor" aria-hidden="true"><path d="M12.05 2C6.51 2 2 6.5 2 12.04c0 1.77.46 3.5 1.33 5.02L2 22l5.09-1.33A10 10 0 0 0 12.05 22c5.54 0 10.04-4.5 10.04-10.04C22.09 6.42 17.59 2 12.05 2Z"/><path d="M17.47 14.38c-.29-.15-1.7-.84-1.96-.93-.26-.1-.45-.15-.64.15-.19.29-.73.93-.9 1.12-.16.19-.33.21-.62.07-.29-.15-1.23-.45-2.34-1.44-.86-.77-1.44-1.72-1.61-2.01-.17-.29-.02-.45.13-.6.13-.13.29-.33.44-.5.15-.16.2-.29.3-.48.1-.2.05-.36-.02-.51-.07-.15-.64-1.54-.88-2.11-.23-.55-.47-.48-.64-.49h-.55c-.19 0-.5.07-.76.36-.26.29-1 1-1 2.44s1.02 2.83 1.17 3.03c.15.19 2.02 3.08 4.89 4.32.68.3 1.21.47 1.63.61.68.22 1.3.18 1.79.11.55-.08 1.67-.68 1.9-1.35.24-.66.24-1.22.17-1.34-.07-.12-.26-.18-.55-.33Z"/></svg>
          Falar com consultor
        </a>
      </div>

      <div>
        <h3>Conexões</h3>
        <ul>
          <li><a href={`${base}energia-por-assinatura#conexao-green`}>Conexão Green</a></li>
          <li><a href={`${base}energia-por-assinatura#conexao-livre`}>Conexão Livre</a></li>
          <li><a href={`${base}geracao-propria#conexao-solar`}>Conexão Solar</a></li>
          <li><a href={`${base}geracao-propria#conexao-placas`}>Conexão Placas</a></li>
          <li><a href={`${base}veiculos#conexao-mob`}>Conexão Mob</a></li>
          <li><a href={`${base}veiculos#conexao-seguros`}>Conexão Seguros</a></li>
          <li><a href={`${base}conectividade`}>Conexão Telecom</a></li>
        </ul>
      </div>

      <div>
        <h3>Navegação</h3>
        <ul>
          {navLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
          <li><a href={`${base}seja-licenciado`}>Seja Licenciado</a></li>
        </ul>
      </div>

      <div>
        <h3>Institucional</h3>
        <ul>
          <li><a href="https://www.igreenenergy.com.br/" target="_blank" rel="noopener">Site oficial iGreen</a></li>
          <li><a href="https://www.igreenenergy.com.br/politica-de-privacidade" target="_blank" rel="noopener">Política de Privacidade</a></li>
        </ul>
      </div>
    </div>

    <div class="site-footer__legal">
      <span>© {year} {company.legalName} · {company.cnpj}</span>
      <span>
        A iGreen Energy é regulamentada pela Lei Federal 14.300/2022. O desconto varia por estado e distribuidora.
        Consulte as condições.
      </span>
    </div>
  </div>
</footer>
