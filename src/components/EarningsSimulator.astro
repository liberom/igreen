---
import { links } from '../data/site';

interface Category {
  name: string;
  bill: number;
  initial: number;
  icon: 'home' | 'store' | 'star' | 'doc' | 'building' | 'bolt' | 'money';
}

interface Props {
  dark?: boolean;
}

const { dark = false } = Astro.props;

/**
 * Simulador de recorrência — espelho do simulador da igreenclub.com.
 * O usuário monta uma carteira por categoria de cliente e vê a comissão
 * recorrente direta de até 4% sobre a conta de luz.
 */
const categories: Category[] = [
  { name: 'Casa', bill: 350, initial: 25, icon: 'home' },
  { name: 'Padaria', bill: 4500, initial: 3, icon: 'store' },
  { name: 'Bar ou lanchonete', bill: 3000, initial: 2, icon: 'star' },
  { name: 'Escola', bill: 10000, initial: 1, icon: 'doc' },
  { name: 'Condomínio', bill: 20000, initial: 1, icon: 'building' },
  { name: 'Indústria', bill: 20000, initial: 1, icon: 'bolt' },
  { name: 'Supermercado', bill: 30000, initial: 1, icon: 'money' },
];

const rate = 0.04;
---
<div class:list={['simulator', { 'simulator--dark': dark }]} data-earnings data-rate={rate}>
  <div class="sim-categories">
    {categories.map((category) => (
      <div class="sim-row">
        <span class="sim-row__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            {category.icon === 'home' && <><path d="M4 11l8-7 8 7v9H4z" /><path d="M10 20v-6h4v6" /></>}
            {category.icon === 'store' && <><path d="M4 9l1.2-5h13.6L20 9" /><path d="M4 9h16v11H4z" /><path d="M9.5 20v-6h5v6" /></>}
            {category.icon === 'star' && <path d="M12 3.5l2.6 5.4 5.9.8-4.3 4.1 1 5.8-5.2-2.8-5.2 2.8 1-5.8L3.5 9.7l5.9-.8L12 3.5z" />}
            {category.icon === 'doc' && <><path d="M7 3h7l4 4v14H7z" /><path d="M14 3v4h4M10 12h5M10 16h5" /></>}
            {category.icon === 'building' && <><rect x="4" y="4" width="11" height="17" rx="1" /><path d="M15 9h5v12h-5M7 8h5M7 12h5M7 16h5" /></>}
            {category.icon === 'bolt' && <path d="M13 2 4 14h6l-1 8 9-12h-6l1-8z" />}
            {category.icon === 'money' && <><circle cx="12" cy="12" r="9" /><path d="M12 6.5v11M9.2 9c0-1.4 1.2-2.3 2.8-2.3s2.8.9 2.8 2.3-1.2 2.3-2.8 2.3-2.8.9-2.8 2.3 1.2 2.3 2.8 2.3 2.8-.9 2.8-2.3" /></>}
          </svg>
        </span>

        <div class="sim-row__meta">
          <h3>{category.name}</h3>
          <p data-bill={category.bill}>conta média de <span style="white-space:nowrap">R$ {category.bill.toLocaleString('pt-BR')}</span></p>
        </div>

        <div class="sim-stepper">
          <button type="button" data-dec data-label={category.name} aria-label={`Diminuir ${category.name}`}>−</button>
          <input
            type="number"
            inputmode="numeric"
            min="0"
            step="1"
            value={category.initial}
            data-count={category.name}
            data-index={categories.indexOf(category)}
            aria-label={`Quantidade de ${category.name}`}
          />
          <button type="button" data-inc data-label={category.name} aria-label={`Aumentar ${category.name}`}>+</button>
        </div>
      </div>
    ))}
  </div>

  <div class="sim-result">
    <p class="sim-result__eyebrow">Sua carteira de exemplo</p>
    <div aria-live="polite" aria-atomic="true">
      <p class="sim-result__label">Total das contas</p>
      <p class="sim-result__total" data-out="portfolio">R$ 0</p>
      <p class="sim-result__label" style="margin-top:18px">× até 4% de comissão direta</p>
      <p class="sim-result__monthly" data-out="month">R$ 0</p>
      <p class="sim-result__unit">por mês</p>
      <div class="sim-result__divider">
        <span class="sim-result__label">Em 12 meses</span>
        <strong data-out="year">R$ 0</strong>
      </div>
    </div>
    <a href={links.licenca} target="_blank" rel="noopener" class="btn btn--brand" style="width:100%;margin-top:22px">
      Quero construir a minha carteira
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </a>
  </div>

  <p class="simulator__note">
    Simulação ilustrativa com a comissão recorrente direta de até 4% da Conexão Green sobre a fatura de
    energia. O percentual integral vale para o licenciado com status PRO no mês. Não é promessa nem garantia
    de ganho: o resultado depende das conexões que você faz e de os clientes seguirem ativos.
  </p>
</div>

<script>
  const root = document.querySelector('[data-earnings]');
  if (root) {
    const rate = Number(root.getAttribute('data-rate') || '0.04');
    const bills = Array.from(root.querySelectorAll('[data-bill]')).map((el) => Number(el.getAttribute('data-bill')));
    const inputs = Array.from(root.querySelectorAll('[data-count]'));
    const outPortfolio = root.querySelector('[data-out="portfolio"]');
    const outMonth = root.querySelector('[data-out="month"]');
    const outYear = root.querySelector('[data-out="year"]');
    const format = (value) =>
      new Intl.NumberFormat('pt-BR', {
        style: 'currency',
        currency: 'BRL',
        maximumFractionDigits: Number.isInteger(value) ? 0 : 2,
      }).format(value);

    function read() {
      return inputs.map((input) => {
        const value = Number(input.value);
        return Number.isFinite(value) ? Math.max(0, Math.floor(value)) : 0;
      });
    }

    function render() {
      const counts = read();
      const total = bills.reduce((sum, bill, index) => sum + bill * (counts[index] || 0), 0);
      const monthly = total * rate;
      outPortfolio.textContent = format(total);
      outMonth.textContent = format(monthly);
      outYear.textContent = format(monthly * 12);
      if (total > 0) root.removeAttribute('data-empty');
      else root.setAttribute('data-empty', '');
    }

    function setCount(input, value) {
      const next = Math.max(0, Math.floor(Number(value) || 0));
      input.value = String(next);
      render();
    }

    inputs.forEach((input, index) => {
      input.addEventListener('input', () => setCount(input, input.value));
      root.querySelector(`[data-dec][data-label="${input.getAttribute('data-count')}"]`)?.addEventListener('click', () => {
        setCount(input, Number(input.value || '0') - 1);
      });
      root.querySelector(`[data-inc][data-label="${input.getAttribute('data-count')}"]`)?.addEventListener('click', () => {
        setCount(input, Number(input.value || '0') + 1);
      });
      const dec = root.querySelector(`[data-dec][data-label="${input.getAttribute('data-count')}"]`);
      const sync = () => {
        if (dec) dec.disabled = Number(input.value || '0') === 0;
      };
      input.addEventListener('input', sync);
      sync();
      void index;
    });

    render();
  }
</script>
